<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <!-- Geographic origin for GPS simulation — change to match your actual test site -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>30.0444</latitude_deg>
      <longitude_deg>31.2357</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Lights -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- ROOM: 10m (x: -5..5) x 8m (y: -4..4), walls 0.2m thick, 2.5m tall -->
    <!-- Door 1: south wall, gap at x -2.5..-1.5, swung open into room -->
    <!-- Door 2: east wall,  gap at y  0.5..1.5,  swung open into room -->
    <!-- ============================================================ -->

    <!-- South wall, segment A (west of door 1): x -5..-2.5 -->
    <model name="wall_south_a">
      <static>true</static>
      <pose>-3.75 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall, segment B (east of door 1): x -1.5..5 -->
    <model name="wall_south_b">
      <static>true</static>
      <pose>1.75 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.5 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.5 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North wall (no door): x -5..5 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall (no door): y -4..4 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall, segment A (south of door 2): y -4..0.5 -->
    <model name="wall_east_a">
      <static>true</static>
      <pose>5 -1.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4.5 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.5 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall, segment B (north of door 2): y 1.5..4 -->
    <model name="wall_east_b">
      <static>true</static>
      <pose>5 2.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 2.5 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 2.5 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Door 1 leaf, hinged at (-2.5,-4), swung fully open into the room along +y -->
    <model name="door1_open">
      <static>true</static>
      <pose>-2.5 -3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1 2</size></box></geometry>
          <material>
            <ambient>0.5 0.32 0.2 1</ambient>
            <diffuse>0.5 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Door 2 leaf, hinged at (5,0.5), swung fully open into the room along -x -->
    <model name="door2_open">
      <static>true</static>
      <pose>4.5 0.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 0.05 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.05 2</size></box></geometry>
          <material>
            <ambient>0.5 0.32 0.2 1</ambient>
            <diffuse>0.5 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- KITCHEN: corner of the room, x 2..5, y -4..-1              -->
    <!-- ============================================================ -->

    <!-- Kitchen counter, against south wall -->
    <model name="kitchen_counter">
      <static>true</static>
      <pose>3.3 -3.65 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.6 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.6 0.9</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.72 1</ambient>
            <diffuse>0.7 0.7 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fridge, corner next to counter -->
    <model name="fridge">
      <static>true</static>
      <pose>4.65 -3.6 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 1.8</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall cabinet along east wall in the kitchen area -->
    <model name="kitchen_cabinet">
      <static>true</static>
      <pose>4.75 -2.4 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.4 0.6</size></box></geometry>
          <material>
            <ambient>0.5 0.32 0.2 1</ambient>
            <diffuse>0.5 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Kitchen table -->
    <model name="kitchen_table">
      <static>true</static>
      <pose>2.4 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.38 0.24 1</ambient>
            <diffuse>0.55 0.38 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Chairs around the table -->
    <model name="kitchen_chair1">
      <static>true</static>
      <pose>2.4 -2.9 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.3 0.2 1</ambient>
            <diffuse>0.45 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kitchen_chair2">
      <static>true</static>
      <pose>2.4 -1.1 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.3 0.2 1</ambient>
            <diffuse>0.45 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kitchen_chair3">
      <static>true</static>
      <pose>1.5 -2 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.3 0.2 1</ambient>
            <diffuse>0.45 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kitchen_chair4">
      <static>true</static>
      <pose>3.3 -2 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.3 0.2 1</ambient>
            <diffuse>0.45 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>